@page
@model IndexModel
@using Syncfusion.EJ2

@{
    ViewData["Title"] = "Home page";
}


<div class="text-center">
    <h1 class="display-4">Sensor Data</h1>

    <ejs-grid id="Grid" dataSource="@Model.SensorDataList" allowPaging="true">
        <e-grid-columns>
            <e-grid-column field="Id" headerText="ID" isPrimaryKey="true"></e-grid-column>
            <e-grid-column field="SensorName" headerText="Sensor Name"></e-grid-column>
            <e-grid-column field="SensorType" headerText="Sensor Type"></e-grid-column>
            <e-grid-column field="ValueX" headerText="Value X"></e-grid-column>
            <e-grid-column field="ValueY" headerText="Value Y"></e-grid-column>
            <e-grid-column field="ValueZ" headerText="Value Z"></e-grid-column>
            <e-grid-column field="Timestamp" headerText="Timestamp" format="yyyy-MM-dd HH:mm:ss"></e-grid-column>
        </e-grid-columns>
    </ejs-grid>
</div>


<script src="https://cdn.syncfusion.com/ej2/dist/ej2.min.js"></script>
<script>
    var grid = new ej.grids.Grid({
    });
    grid.appendTo('#Grid');
</script>